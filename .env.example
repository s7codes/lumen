# Production settings for docker-compose.yml. Copy to .env beside it and fill
# in (cp .env.example .env). Compose reads .env for variable substitution;
# never commit the real file.

# Public hostname. Caddy requests its certificate on the first start, so the
# DNS A (and AAAA) record must already point at this server.
DOMAIN=lumen.s7codes.dev

# Further hostnames the app answers for, comma-separated (for example a
# www. alias Caddy also serves). Loopback, lumen.s7codes.dev, s7codes.dev and
# DOMAIN are always allowed; any other Host header is refused with 421.
LUMEN_ALLOWED_HOSTS=

# Reverse-proxy hops in front of the app: 1 behind the bundled Caddy, 2 when a
# CDN sits in front of Caddy as well.
LUMEN_TRUST_PROXY=1

# HMAC key that signs session tokens: 32 or more random characters, for
# example the output of: openssl rand -hex 32
# Left empty (or set to a placeholder), each restart signs every visitor out.
LUMEN_SESSION_SECRET=

# Optional Lumen AI provider. With nothing set, the deterministic MCP
# orchestrator answers; under auto the first key set wins.
LUMEN_LLM_PROVIDER=auto
LUMEN_LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Ollama on the Docker host: http://host.docker.internal:11434
OLLAMA_BASE_URL=
